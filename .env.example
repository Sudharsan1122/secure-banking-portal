# Application
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8080

# Database
DB_HOST=db
DB_PORT=3306
DB_NAME=banking
DB_USER=sbp_user
DB_PASS=change_me_in_production
DB_ROOT_PASS=change_me_in_production

# Security
SESSION_LIFETIME_IDLE=900
SESSION_LIFETIME_ABSOLUTE=28800
CSRF_TOKEN_TTL=3600

# Metrics (Prometheus)
METRICS_TOKEN=generate_a_long_random_token

# Demo mode (MUST be false in production)
DEMO_MODE=false
