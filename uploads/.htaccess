# Protect uploads directory from direct execution of scripts
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

# In case server allows execution, disable PHP parsing
php_flag engine off
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8
